  "targets": [
    {
      "name": "Clocky",
      "id": "4FA1A21430AD90B70081FEFF",
      "product": "Products/Clocky.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ARCHS[sdk=watchos*]": [
